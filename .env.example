# Copy to .env.local and fill in. Never commit .env.local. All values below are placeholders.

# Connection used ONLY by migrations / admin scripts (database owner). Never used by the web app at runtime.
DATABASE_ADMIN_URL=postgres://localhost:5432/ekiben_tracker

# Connection used by the web app at runtime: a restricted role (no superuser, no BYPASSRLS).
# `npm run db:setup` creates this role using APP_DB_PASSWORD.
DATABASE_URL=postgres://tracker_app:change-me-local-only@localhost:5432/ekiben_tracker
APP_DB_PASSWORD=change-me-local-only

# Comma-separated email domains allowed to sign up. PROVISIONAL: confirm with Ekiben.
ALLOWED_EMAIL_DOMAINS=ekibenbaltimore.com

# Long random string (e.g. `openssl rand -hex 32`). Used to hash login codes.
AUTH_SECRET=replace-with-a-long-random-string

# Reporting time zone (IANA name). Handles daylight saving automatically.
APP_TIME_ZONE=America/New_York

# Email delivery for login codes.
#   console = print the code in the server log. LOCAL DEV ONLY; the app refuses to start with it in production.
#   smtp    = send through the SMTP_* settings below.
EMAIL_TRANSPORT=console
EMAIL_FROM=Ekiben Project Tracker <no-reply@example.invalid>
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
