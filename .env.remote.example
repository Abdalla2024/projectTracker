# Copy to .env.remote and fill in YOURSELF in your editor (do not paste these into chat).
# .env.remote is ignored by git and is never uploaded to Vercel. Used by:
#   npm run db:setup:remote      (create the app's database role + apply migrations)
#   npm run admin:remote -- ...  (grant/revoke admins, disable users)
# Where each value comes from is noted per line. Replace every placeholder in capitals.

# ---- Owner connection (used only from your machine) ----
# Supabase dashboard -> Connect -> "Session pooler" (port 5432). It works over IPv4; the "Direct connection"
# is IPv6-only by default. The user looks like  postgres.PROJECT_REF  and the password is your database password.
DATABASE_ADMIN_URL=postgresql://postgres.PROJECT_REF:DB_PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres

# A NEW long random password that setup gives the app's restricted role (not your Supabase password).
# Generate one with:  openssl rand -base64 24 | tr -d '/+=' 
APP_DB_PASSWORD=

# Supabase's CA certificate, downloaded from the dashboard (Project Settings -> Database -> SSL configuration).
# Absolute path to the .crt file on your machine. It is a public certificate, not a secret.
DATABASE_CA_CERT_FILE=/ABSOLUTE/PATH/TO/supabase-ca.crt

# ---- What the DEPLOYED app will use (values I copy into Vercel for you; they are never printed) ----
# Supabase -> Connect -> "Transaction pooler" (port 6543). The user is tracker_app.PROJECT_REF (the app role
# plus the project ref), and the password is APP_DB_PASSWORD above, URL-encoded if it has special characters.
DATABASE_URL=postgresql://tracker_app.PROJECT_REF:APP_DB_PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres

# ---- Email (from your SMTP provider; see docs/PRIVATE-DEMO.md section 1) ----
EMAIL_FROM=Ekiben Project Tracker <sender@your-verified-domain>
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
