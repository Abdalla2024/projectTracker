{
  "name": "ekiben-project-tracker",
  "version": "0.1.0",
  "private": true,
  "description": "Internal project tracker for Ekiben (demo)",
  "engines": {
    "node": ">=20.9"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:setup": "node --env-file-if-exists=.env.local scripts/db-setup.mjs",
    "db:seed-demo": "node --env-file-if-exists=.env.local scripts/seed-demo.mjs",
    "admin": "node --env-file-if-exists=.env.local scripts/admin.mjs",
    "db:setup:remote": "node --env-file=.env.remote scripts/db-setup.mjs",
    "admin:remote": "node --env-file=.env.remote scripts/admin.mjs"
  },
  "dependencies": {
    "luxon": "^3.7.2",
    "next": "^16.4.2",
    "nodemailer": "^10.1.7",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/luxon": "^3.7.6",
    "@types/node": "^26.6.5",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
